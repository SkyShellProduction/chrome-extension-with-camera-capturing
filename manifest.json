{
  "manifest_version": 3,
  "name": "Desk Time Tracker",
  "description": "Tracks time at the computer via webcam, time in browser tabs, and takes screenshots. All data stays local.",
  "version": "1.3.0",
  "permissions": [
    "offscreen",
    "storage",
    "idle",
    "alarms",
    "unlimitedStorage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Desk Time Tracker"
  },
  "options_page": "stats.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
